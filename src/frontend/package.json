    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "lamejs": "^1.2.1",
    "postcss": "^8.4.41",
