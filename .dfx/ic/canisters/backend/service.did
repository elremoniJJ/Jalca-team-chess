 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  adminBackfillCompetition: (entry: BackfillEntry, winnerPrincipal:
   principal) -> ();
  adminBackfillPrizeAllocation: (sunday: Timestamp, poolE8s: nat) ->
   (AllocationResult);
  adminFinalizeCompetitions: () -> (FinalizeReport);
  appendPbppInformation: (content: text) -> (PbppInformationEntry);
  appendStorySection: ("text": text) -> ();
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  attemptMove: ("principal": PseudoPrincipal, fromSquare: nat, toSquare: 
   nat, promotion: opt PieceType) -> (MoveResult);
  burnAndPlay: ("principal": PseudoPrincipal, request: BurnAndPlayRequest) ->
   (BurnAndPlayResult2);
  burnNft: (tokenId: nat) -> (BurnOutcome);
  burnNfts: (tokenIds: vec nat) -> (vec BurnOutcome);
  castKickVote: ("principal": PseudoPrincipal, target: PseudoPrincipal) ->
   (KickResult);
  castResignVote: ("principal": PseudoPrincipal) -> (text);
  castVote: ("principal": PseudoPrincipal, vote: Vote) ->
   (variant {
      err: text;
      ok;
    });
  checkAllowance: (player: principal) -> (Allowance);
  claimPrize: (competition: Timestamp, rank: nat, recipient: principal) ->
   (ClaimResult);
  claimStoryAuthorship: () -> (principal);
  clearNftMintAttempts: () -> ();
  clearPrizeAllocation: (sunday: Timestamp) -> (AllocationResult);
  concludeByInsufficientMaterial: (now: Timestamp) -> ();
  concludeByResignation: (winner: Team, now: Timestamp) -> ();
  concludeBySpellCheck: (winner: Team, spellName: text, now: Timestamp) -> ();
  createDrinkingAssignment: (capturedPiece: PieceType, lostTeam: Team,
   moveIndex: nat) -> (DrinkingAssignment);
  createEnPassantDrinkingAssignment: (lostTeam: Team, moveIndex: nat) ->
   (DrinkingAssignment);
  createEnPassantExerciseAssignments: (lostTeam: Team, moveIndex: nat) ->
   (vec ExerciseAssignment);
  createExerciseAssignment: (capturedPiece: PieceType, lostTeam: Team,
   moveIndex: nat) -> (ExerciseAssignment);
  execute: (qJson: text) -> (Result) query;
  fillStoryGap: (index: nat, "text": text) -> ();
  fireApproval: (player: PseudoPrincipal) -> (ApprovalResult);
  getAdminAllocatedCompetitionDates: () -> (vec AdminCompetitionDate);
  getAdminCompetitionDetail: (sunday: Timestamp) -> (AdminCompetitionDetail);
  getAdminPrizeClaims: () -> (AdminPrizeOverview__1);
  getAdminPrizeOverview: () -> (AdminPrizeOverview);
  getApiDoc: () -> (text) query;
  getApprovalState: (player: PseudoPrincipal) -> (ApprovalStateResult) query;
  getArchivedPrizePool: (sunday: Timestamp) -> (opt ArchivedPrizePool) query;
  getBets: () -> (vec BetRecord) query;
  getBoardFrames: () -> (BoardFrameList) query;
  getBurnState: () -> (BurnStateSnapshot) query;
  getCallerUserRole: () -> (UserRole) query;
  getClaimStatus: (sunday: Timestamp) -> (ClaimStatus) query;
  getCompFinalizeState: () -> (CompFinalizeState) query;
  getCurrentPrizePool: () -> (PrizePool) query;
  getDrinkingAssignments: () -> (vec DrinkingAssignment) query;
  getExerciseAssignments: () -> (vec ExerciseAssignment) query;
  getFirstPrizeForSunday: (sunday: Timestamp) -> (opt nat) query;
  getGameNumber: () -> (nat) query;
  getGameRecord: () -> (GameRecord) query;
  getGameSettingsSnapshot: () -> (GameSettingsSnapshot) query;
  getGameState: ("principal": PseudoPrincipal) -> (GameStateSnapshot) query;
  getKickState: () -> (KickState) query;
  getMintAttemptsByGame: () -> (vec MintAttemptGroup) query;
  getMintStatusForPlayer: (walletAddress: text) -> (opt MintOutcome) query;
  getMintStatusesForGame: () -> (vec MintStatusEntry) query;
  getMyPrize: () -> (opt MyPrize);
  getMyWins: () -> (MyWins) query;
  getNextGameSettings: () -> (NextGameSettings) query;
  getNftMetadata: (tokenId: nat) -> (opt MintMetadata) query;
  getNftMetadataBatch: (tokenIds: vec nat) -> (vec opt MintMetadata) query;
  getNftsForOwner: (owner: text) -> (vec nat);
  getPastWinners: () -> (vec PastWinnerRow);
  getPbppInformation: () -> (vec PbppInformationEntry);
  getPrizeCanisterBalances: () -> (PrizeBalancesResult);
  getRealBets: () -> (vec RealBetRecord) query;
  getResignState: () -> (ResignState) query;
  getResults: () -> (vec ResultRecord) query;
  getSettlements: () -> (vec SettlementRecord) query;
  getShieldResolutionSnapshot: () -> (ShieldResolutionSnapshot) query;
  getShieldState: () -> (ShieldState) query;
  getSpellBoardState: () -> (SpellBoardView) query;
  getSpellNameForGame: (gameNumber: nat, walletAddress: text) ->
   (opt text) query;
  getSpellTable: () -> (SpellTable) query;
  getStoryAuthor: () -> (opt principal) query;
  getStorySections: () -> (vec StoryRow) query;
  getSundayCompStandings: (limit: nat) -> (vec CompStandingRow);
  getSundayCompStatus: () -> (CompStatus) query;
  getUpcomingAllocationStatuses: () -> (vec SundayAllocationStatus);
  getVoteTally: () -> (VoteTally) query;
  getWinCreditPreview: () ->
   (record {
      celebrationWinner: opt Team;
      competitionLive: bool;
      gameNumber: nat;
      phase: GamePhase;
      players: vec WinCreditPreviewPlayer;
    }) query;
  getWinnerRanking: (limit: nat) -> (vec WinnerRankingRow) query;
  heartbeat: ("principal": PseudoPrincipal) -> (variant {
                                                  err: text;
                                                  ok;
                                                });
  isCallerAdmin: () -> (bool) query;
  isInsufficientMaterialForSquares: (pieces:
   vec record {
         nat;
         PieceType;
         Team;
       }) -> (bool) query;
  kickBot: ("principal": PseudoPrincipal) -> (text);
  login: ("principal": PseudoPrincipal, username: text, walletAddress:
   opt text, walletSource: WalletSource) -> (LoginResult);
  loginRanked: (rosterKey: text, username: text, walletAddress: opt text,
   walletSource: WalletSource) -> (LoginResult);
  logout: ("principal": PseudoPrincipal) -> ();
  mintGameNfts: () -> ();
  placeBet: (args: PlaceBetArgs) -> (PlaceBetResult);
  pressStoryDelete: (index: nat) -> ();
  pressStoryKeep: (index: nat) -> ();
  previewPrizeAllocation: (poolE8s: nat) -> (PrizePreviewResult);
  recordBurn: ("principal": PseudoPrincipal, request: BurnRequest) ->
   (BurnResult);
  recordConsentError: (player: PseudoPrincipal, error: text) -> ();
  recordGameResult: (result: GameResult) -> (ResultRecord);
  reportOutcome: (args: ReportOutcomeArgs) -> (ReportOutcomeResult);
  requestNewGame: ("principal": PseudoPrincipal) -> (variant {
                                                       err: text;
                                                       ok;
                                                     });
  runMaintenance: (now: Timestamp) -> ();
  savePrizeAllocation: (sunday: Timestamp, poolE8s: nat) ->
   (AllocationResult);
  schema: () -> (text) query;
  setApprovalGranted: (player: PseudoPrincipal, granted: bool) ->
   (ApprovalStateResult);
  setJalcaPrincipal: ("principal": principal) -> ();
  setPbppCanisterPrincipal: ("principal": principal) -> ();
  setPrizeCanisterPrincipal: ("principal": principal) -> ();
  startGame: (args: StartGameArgs) -> (StartGameResult);
  submitBet: (pot: Pot, prediction: Prediction, playerPrincipal:
   PseudoPrincipal, displayUsername: text, anonymous: bool) -> (BetRecord);
  updateWalletAddress: ("principal": PseudoPrincipal, walletAddress:
   opt text, walletSource: WalletSource) -> ();
  withdrawKickVote: ("principal": PseudoPrincipal, target:
   PseudoPrincipal) -> (KickResult);
  withdrawResignVote: ("principal": PseudoPrincipal) -> (text);
  writeStory: ("text": text) -> ();
}
